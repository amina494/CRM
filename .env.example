# Copy to .env and fill in. Everything except SESSION_SECRET/PUBLIC_URL is optional:
# unconfigured channels are logged to the Outbox instead of being sent.

PORT=3000
# The address guests and drivers will open (used in invitation and driver links).
PUBLIC_URL=http://localhost:3000
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ORG_NAME=YAX

# One-time sign-in codes required for admins and coordinators.
# Defaults to true when NODE_ENV=production, false otherwise.
# REQUIRE_2FA=true
# How many reverse proxies (nginx, Caddy, a load balancer) sit in front of the
# app. 0 = people reach the app directly. Must be right, or sign-in limits can
# be bypassed (too high) or everyone shares one address (too low).
TRUST_PROXY=0
# Brand colours for invitation emails and wallet passes (the web app's are in web/styles.css)
# BRAND_PRIMARY=#1e1b1a
# BRAND_ACCENT=#ef5f22
# DATABASE_PATH=./data/crm.db

# --- Email (any SMTP provider: Microsoft 365, Google Workspace, SendGrid, SES…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Guest Relations <invitations@example.com>

# --- WhatsApp & SMS via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# --- Apple Wallet (Apple Developer account → Certificates → Pass Type ID)
APPLE_PASS_TYPE_ID=pass.com.example.events
APPLE_TEAM_ID=
APPLE_SIGNER_CERT=./certs/signerCert.pem
APPLE_SIGNER_KEY=./certs/signerKey.pem
APPLE_SIGNER_KEY_PASSPHRASE=
APPLE_WWDR_CERT=./certs/wwdr.pem

# --- Google Wallet (Google Pay & Wallet Console issuer + service account JSON key)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=./certs/google-wallet-sa.json
